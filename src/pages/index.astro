---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <style>
    /* Hero Welcome Text Area */
    .hero-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      min-height: 70vh;
      padding: 20px;
    }
    .hero-title {
      font-size: 56px;
      font-weight: 900;
      letter-spacing: -2px;
      text-transform: uppercase;
      margin-bottom: 10px;
      line-height: 1;
    }
    @media (min-width: 768px) {
      .hero-title { font-size: 80px; }
    }
    .hero-subtitle {
      color: #737373;
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 4px;
      text-transform: uppercase;
      margin-bottom: 60px;
    }

    /* Dual Entrance Portal Grid Links */
    .portal-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 30px;
      width: 100%;
      max-width: 900px;
    }
    .portal-card {
      background-color: #171717;
      border: 1px solid #262626;
      border-radius: 12px;
      padding: 40px 30px;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      min-height: 250px;
      transition: all 0.3s ease;
    }
    .portal-card:hover {
      border-color: #525252;
      background-color: #1c1c1c;
      transform: translateY(-4px);
    }
    .portal-num {
      color: #525252;
      font-family: monospace;
      font-size: 14px;
      font-weight: 700;
      margin-bottom: 5px;
    }
    .portal-name {
      color: #ffffff;
      font-size: 28px;
      font-weight: 800;
      text-transform: uppercase;
      margin-bottom: 8px;
    }
    .portal-desc {
      color: #a3a3a3;
      font-size: 14px;
      line-height: 1.4;
    }
  </style>

  <div class="hero-container">
    <div>
      <h1 class="hero-title">AAKASH'S INK & THREAD</h1>
      <p class="hero-subtitle">Custom Tattoos & Premium Retail</p>
    </div>

    <div class="portal-grid">
  <!-- Left Entrance Card Link: Studio Gallery -->
  <a href={`${import.meta.env.BASE_URL}gallery/`} class="portal-card">
    <span class="portal-num">01 // VISUAL WORK</span>
    <h2 class="portal-name">Tattoo Studio →</h2>
    <p class="portal-desc">Explore our resident tattoo artist(AAKASH), healed blackwork portfolios, and open calendar booking logs.</p>
  </a>

  <!-- Right Entrance Card Link: Streetwear Shop -->
  <a href={`${import.meta.env.BASE_URL}shop/`} class="portal-card">
    <span class="portal-num">02 // PREMIUM DROPS</span>
    <h2 class="portal-name">Shop Apparel →</h2>
    <p class="portal-desc">Browse our limited architectural garments, heavyweight fleece hoodies, and lifestyle drops.</p>
  </a>
</div>

  </div>
</Layout>
