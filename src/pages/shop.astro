---
import Layout from '../layouts/Layout.astro';
import BuyButton from '../components/BuyButton.jsx';

const collections = [
  {
    name: "Cyber-Skull Heavyweight Hoodie",
    price: "$85.00",
    tag: "LIMITED DROP",
    desc: "450GSM ultra-thick French terry cotton. Screen printed custom back artwork.",
    vector: `<svg viewBox="0 0 100 100" fill="none" stroke="#888" stroke-width="2"><path d="M20,40 L30,25 L40,25 L50,35 L60,25 L70,25 L80,40 L75,85 L25,85 Z"/><path d="M35,85 L35,90 M65,85 L65,90"/><rect x="40" y="45" width="20" height="25" rx="2"/></svg>`
  },
  {
    name: "Sacred Geometry Oversized Tee",
    price: "$42.00",
    tag: "BEST SELLER",
    desc: "Vintage washed charcoal gray luxury tee. Relaxed drop-shoulder silhouette.",
    vector: `<svg viewBox="0 0 100 100" fill="none" stroke="#888" stroke-width="2"><path d="M15,30 L30,20 L70,20 L85,30 L80,85 L20,85 Z"/><line x1="30" y1="20" x2="35" y2="35"/><line x1="70" y1="20" x2="65" y2="35"/></svg>`
  },
  {
    name: "Japanese Dragon Workwear Jacket",
    price: "$140.00",
    tag: "PRE-ORDER",
    desc: "Heavy durable canvas outershell featuring intricate red embroidery details.",
    vector: `<svg viewBox="0 0 100 100" fill="none" stroke="#888" stroke-width="2"><path d="M20,25 L40,25 L50,35 L60,25 L80,25 L85,85 L15,85 Z"/><line x1="50" y1="35" x2="50" y2="85"/><circle cx="45" cy="50" r="1.5" fill="#888"/><circle cx="45" cy="65" r="1.5" fill="#888"/></svg>`
  },
  {
    name: "Ink & Thread Canvas Tote Bag",
    price: "$28.00",
    tag: "ACCESSORY",
    desc: "Reinforced straps with internal pocket slots optimized for daily travel.",
    vector: `<svg viewBox="0 0 100 100" fill="none" stroke="#888" stroke-width="2"><rect x="25" y="40" width="50" height="45" rx="2"/><path d="M35,40 C35,15 65,15 65,40"/></svg>`
  }
];
---

<Layout title="The Drop - Streetwear Apparel">
  <style>
    .shop-header {
      border-bottom: 1px solid #262626;
      padding-bottom: 30px;
      margin-bottom: 50px;
    }
    .shop-header h1 {
      font-size: 42px;
      font-weight: 900;
      letter-spacing: -1px;
      text-transform: uppercase;
      margin-top: 5px;
    }
    .shop-header span {
      color: #737373;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 2px;
    }
    
    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 30px;
    }
    .product-card {
      background-color: #111111;
      border: 1px solid #222222;
      border-radius: 12px;
      padding: 16px;
      display: flex;
      flex-direction: column;
    }
    
    .image-container {
      position: relative;
      width: 100%;
      height: 280px;
      background-color: #161616;
      border-radius: 8px;
      margin-bottom: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px;
    }
    .image-container :global(svg) {
      width: 100%;
      height: 100%;
      max-height: 160px;
    }
    .badge {
      position: absolute;
      top: 12px;
      left: 12px;
      background-color: #ffffff;
      color: #000000;
      font-size: 10px;
      font-weight: 900;
      padding: 4px 8px;
      letter-spacing: 1px;
      border-radius: 4px;
    }
    .product-meta {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 10px;
    }
    .product-title {
      font-size: 18px;
      font-weight: 700;
    }
    .product-price {
      font-size: 16px;
      color: #a3a3a3;
      font-weight: 600;
    }
    .product-desc {
      color: #666666;
      font-size: 13px;
      line-height: 1.5;
      margin-bottom: 20px;
      flex-grow: 1;
    }
  </style>

  <div class="shop-header">
    <span>CURATED RETAIL</span>
    <h1>DROP 01: ARCHETYPE</h1>
  </div>

  <div class="product-grid">
    {collections.map((product) => (
      <div class="product-card">
        <div class="image-container">
          <span class="badge">{product.tag}</span>
          <Fragment set:html={product.vector} />
        </div>
        
        <div class="product-meta">
          <h2 class="product-title">{product.name}</h2>
          <span class="product-price">{product.price}</span>
        </div>
        
        <p class="product-desc">{product.desc}</p>
        <BuyButton client:load productName={product.name} />
      </div>
    ))}
  </div>
</Layout>
