---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | AAKASH'S Ink & Thread Co.</title>
    
    <style is:global>
      /* Pure CSS Fallback Engine */
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        background-color: #0d0d0d;
        color: #ffffff;
        font-family: system-ui, -apple-system, sans-serif;
        padding-top: 80px;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      
      /* Navigation Styling */
      .nav-bar {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        background-color: #141414;
        border-b: 1px solid #262626;
        padding: 20px 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 1000;
      }
      .nav-logo {
        font-weight: 900;
        font-size: 20px;
        letter-spacing: 2px;
        color: #ffffff;
        text-decoration: none;
      }
      .nav-links a {
        color: #a3a3a3;
        text-decoration: none;
        margin-left: 30px;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
      }
      .nav-links a:hover {
        color: #ffffff;
      }

      /* Main layout wrapper */
      .main-content {
        flex: 1;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 20px;
      }

      /* Footer Styling */
      footer {
        text-align: center;
        padding: 40px;
        border-top: 1px solid #262626;
        color: #525252;
        font-size: 12px;
        letter-spacing: 1px;
        background-color: #0a0a0a;
      }
    </style>
  </head>
  <body>
    <!-- <nav class="nav-bar">
      <a href="/" class="nav-logo">AAKASH'S INK & THREAD.</a>
      <div class="nav-links">
        <a href="/gallery">Tattoo Studio</a>
        <a href="/shop">Apparel</a>
      </div>
    </nav> -->
    <!-- Luxury Navbar with Base URLs -->
<nav class="nav-bar">
  <a href={`${import.meta.env.BASE_URL}`} class="nav-logo">INK & THREAD.</a>
  <div class="nav-links">
    <a href={`${import.meta.env.BASE_URL}gallery/`}>Tattoo Studio</a>
    <a href={`${import.meta.env.BASE_URL}shop/`}>Apparel</a>
  </div>
</nav>

    <main class="main-content">
      <slot />
    </main>

    <footer>
      <p>© 2026 AAKASH'S INK & THREAD STUDIO. MADE FOR THE REBELS.</p>
    </footer>
  </body>
</html>
